{
  "inputs": [
    {
      "type": "promptString",
      "id": "fokals-key",
      "description": "Fokals key (make one on your account page at fokals.com/account)",
      "password": true
    }
  ],
  "servers": {
    "fokals": {
      "type": "http",
      "url": "https://mcp.fokals.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:fokals-key}"
      }
    }
  }
}
